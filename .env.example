# Copy to .env (git-ignored) and fill in. site.yaml refers to these by NAME only.
# Google API key with PageSpeed Insights API v5 and Chrome UX Report API enabled.
GOOGLE_API_KEY=

# WordPress over REST (dedicated `speedpilot` admin user with an Application Password).
WP_DEMO_REST_USER=
WP_DEMO_REST_APP_PASSWORD=
# HMAC secret shared with the SpeedPilot agent mu-plugin (define SPEEDPILOT_HMAC_SECRET in wp-config.php).
WP_DEMO_AGENT_HMAC_SECRET=
# Read-only database user for audits (optional).
WP_DEMO_DB_RO_USER=
WP_DEMO_DB_RO_PASSWORD=

# Shopify: Theme Access app password for Shopify CLI (theme-only token).
SHOPIFY_DEMO_THEME_ACCESS_PASSWORD=
# Optional custom app with read-only scopes (read_themes, read_products, read_content).
SHOPIFY_DEMO_ADMIN_TOKEN=
# Storefront password, if the store is password protected.
SHOPIFY_DEMO_STOREFRONT_PASSWORD=

# Cloudflare read-only API token (optional).
CLOUDFLARE_DEMO_API_TOKEN=

# Encryption key for backups at rest (32 bytes, base64). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SPEEDPILOT_BACKUP_KEY=
