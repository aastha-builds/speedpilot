<div class="card">
  <a href="{{ product.url }}">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 990px) 25vw, 50vw' }}
    {%- endif -%}
    <span class="card__title">{{ product.title }}</span>
  </a>
  <span class="card__price">{{ price | money }}</span>
</div>
