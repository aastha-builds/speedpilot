<a class="button" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
{% schema %}
{ "name": "Button", "settings": [ { "type": "text", "id": "label", "label": "Label", "default": "Shop now" }, { "type": "url", "id": "link", "label": "Link" } ], "presets": [{ "name": "Button" }] }
{% endschema %}
