<section class="search">
  <form action="{{ routes.search_url }}"><input type="search" name="q" value="{{ search.terms | escape }}" data-predictive-search></form>
  {%- if search.performed -%}<p>{{ search.results_count }} results</p>{%- endif -%}
</section>
{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
