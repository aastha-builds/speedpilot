{
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.*)", "Bash(speedpilot approve:*)"],
    "allow": ["Read(./.env.example)"]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"" } ] },
      { "matcher": "mcp__chrome-devtools__.*", "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"" } ] },
      { "matcher": "Read", "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"" } ] }
    ]
  }
}
